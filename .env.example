# MongoDB connection string // Eg.: mongodb://<user>:<password>@<cluster>.mongodb.net/fleetlog 
MONGODB_URI= 

# Random secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Secret URL paths for the Admin and Fleet Manager self-registration portals:
ADMIN_PORTAL_PATH=admin-portal-8x2k
MANAGER_PORTAL_PATH=manager-portal-q4j9

# ADMIN & MANAGER URLs:
# Admin portal:   http://localhost:3000/admin-portal-8x2k
# Manager portal: http://localhost:3000/manager-portal-q4j9
